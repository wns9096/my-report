# 비밀번호는 코드에 절대 쓰지 않는다. st.secrets 로 읽고, 파일은 올리지 않는다.
.streamlit/secrets.toml

__pycache__/
*.pyc

# 산출물은 다시 만들면 된다. 다만 게이트 기록은 근거라서 남긴다.
fonts/*.ttf

outputs/*.png
outputs/*.pdf
# doc_print.py 가 종이 폭을 재려고 잠깐 만드는 자리. 산출물이 아니다.
outputs/_print/
!outputs/gates.jsonl

# 인증 키. 한 번 올라가면 커밋을 지워도 이력에 남는다 (교안 11-2).
# 이 앱은 키를 안 쓰지만, 안 쓰는 동안 걸어 두는 것이 그물이다.
*credentials*.json
*service-account*.json
